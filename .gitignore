# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv-cache/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets & local config
secrets.yaml
.env
*.local.yaml

# Runtime data (SQLite history, runtime settings)
ems/data/
/data/
*.sqlite
*.sqlite-*

# Frontend (React/Vite) + Playwright
node_modules/
ems/web/static/dist/
*.tsbuildinfo
test-results/
playwright-report/
.playwright/
.playwright-mcp/

# OS / editor
.DS_Store
.idea/
.vscode/

# e2e throwaway DB (hermetic test isolation)
ems/web/frontend/.e2e-data/
# root-level e2e runtime state (SQLite + server logs) written by an e2e harness run
/.e2e-data/

# Installer's repo-local toolchain (Node fetched by scripts/install.sh)
.tools/

# Local git worktrees for isolated feature work
.worktrees/
# Same, for worktrees created under .claude/. Must stay ignored: a nested git
# worktree in a non-ignored path breaks tooling that copies untracked files.
.claude/worktrees/

# local disarmed demo instance (never commit)
.demo-data/
